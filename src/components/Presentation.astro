---
import PresentationTitle from "./PresentationTitle.astro";
import PresentationAvatar from "./PresentationAvatar.astro";
import ContactLink from "./ContactLink.astro";
import PresentationDetails from "./PresentationDetails.astro";
import avatar from "@assets/images/avatar.webp";
import { contact } from "@assets/data/contact";
import type { Locales } from "src/types/locales";
import { pageData } from "@assets/data/pageData";

const locale = Astro.currentLocale as Locales;
---

<section class="flex flex-col items-center gap-6 my-10">
  <PresentationTitle
    title="Oscar Umaña"
    subTitle={pageData[locale].presentation.greeting}
  />
  <PresentationAvatar imageUrl={avatar} />
  <div class="flex items-center space-x-5 mb-3">
    <ContactLink
      href={contact.linkedin}
      ariaLabel="Oscar Umaña Linkedin"
      iconName="bi:linkedin"
    />
    <ContactLink
      href={contact.github}
      ariaLabel="Oscar Umaña Github"
      iconName="bi:github"
    />
    <ContactLink
      href={`mailto:${contact.email}`}
      ariaLabel="Oscar Umaña email"
      iconName="ion:mail"
    />
  </div>

  <PresentationDetails />

  <div
    class="flex items-center flex-wrap sm:space-x-5 max-sm:flex-col max-sm:space-y-5"
  >
    <a
      href="#Projects"
      class="bg-transparent hover:bg-red-500 text-neutral-200 hover:text-black py-2 px-4 border border-neutral-100 hover:border-transparent rounded"
    >
      {pageData[locale].presentation.projectsButton}
    </a>
    <a
      href="#Experience"
      class="bg-transparent hover:bg-red-500 text-neutral-200 hover:text-black py-2 px-4 border border-neutral-100 hover:border-transparent rounded"
    >
      {pageData[locale].presentation.experienceButton}
    </a>
  </div>
</section>
