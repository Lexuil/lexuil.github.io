---
import { cn } from '@/lib/utils';
import { techIcons } from '@/types/tech-icons';
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  showLabel?: boolean;
  size?: "sm" | "md" | "lg";
}

const { name, showLabel = false, size = "md" } = Astro.props;

const tech = techIcons[name];
const iconSize = size === "sm" ? 'size-4' : size === "md" ? 'size-5' : 'size-7';
---

{!tech
  ? <span class="px-2.5 py-1 text-[10px] tracking-wider rounded-md bg-card text-muted-foreground border border-border/50 font-mono">
      {name}
    </span>
  : <span 
      class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] tracking-wide rounded-md bg-card/80 border border-border/50 transition-all duration-300 hover:border-border hover:bg-card group cursor-default"
    >
      <Icon
        name={tech.icon}
        class={cn("opacity-70 group-hover:opacity-100 transition-opacity duration-300", iconSize)}
        style={{ color: tech.color }}
      />
      {showLabel && (
        <span class="text-muted-foreground group-hover:text-foreground transition-colors duration-300 font-medium">
          {name}
        </span>
      )}
    </span>
}