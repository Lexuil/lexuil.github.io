---
import AnimatedSection from "@/components/animated-section.astro";
import { Icon } from "astro-icon/components";
import { sectionTexts } from "@/i18/sections";
import type { Locales } from "@/types/locales";

interface Props {
  email: string;
}

const { email } = Astro.props;
const locale = Astro.currentLocale as Locales;
const texts = sectionTexts[locale].footer;
---

<footer class="py-24 lg:py-32 px-6 lg:px-12 border-t border-border/30">
  <div class="max-w-6xl mx-auto">
    <AnimatedSection>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-24">
        <div>
          <h2 class="text-3xl lg:text-4xl font-semibold text-foreground mt-4 mb-6 tracking-tight text-balance">
            {texts.title}
          </h2>
          <p class="text-muted-foreground leading-relaxed max-w-md mb-8">
            {texts.description}
          </p>
          <a
            href={`mailto:${email}`}
            class="group inline-flex items-center gap-2 text-sm font-medium text-foreground hover:text-primary transition-colors"
          >
            <span class="border-b border-foreground/30 group-hover:border-primary pb-0.5 transition-colors">
              {email}
            </span>
            <Icon name="lucide:arrow-up-right" class="size-4 opacity-0 -translate-y-1 translate-x-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:translate-x-0 transition-all duration-300" />
          </a>
        </div>
        
        <div class="lg:text-right lg:self-end">
          <p class="text-xs text-muted-foreground/50 font-mono tracking-wider">
            {texts.builtWithAstro}
          </p>
        </div>
      </div>
    </AnimatedSection>
  </div>
</footer>
