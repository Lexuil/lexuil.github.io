---
import AnimatedSection from "@/components/animated-section.astro";
import TechIconMinimal from "@/components/tech-icon-minimal.astro";
import type { Project } from "@/types/project";
import type { Locales } from "@/types/locales";
import { Icon } from "astro-icon/components";

interface Props {
  project: Project;
  index: number;
}

const locale = Astro.currentLocale as Locales;
const { project, index } = Astro.props;

const imageLoaded = true;
const isEven = index % 2 === 0;
---

<AnimatedSection delay={index * 150}>
  <article class="group relative">
    {/* Project Number */}
    <div class="absolute -left-4 lg:-left-12 top-0 hidden lg:block">
      <span class="font-mono text-6xl font-bold text-border/30 group-hover:text-primary/20 transition-colors duration-500">
        {String(index + 1).padStart(2, "0")}
      </span>
    </div>

    <div class={`grid lg:grid-cols-12 gap-6 lg:gap-0 items-center`}>
      {/* Screenshot Section */}
      <div
        class={`relative lg:col-span-7 ${
          isEven ? "lg:col-start-1" : "lg:col-start-6"
        } lg:row-start-1`}
      >
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block relative overflow-hidden rounded-lg"
        >
          {/* Decorative frame */}
          <div class="absolute inset-0 border border-border/40 rounded-lg z-10 pointer-events-none group-hover:border-primary/30 transition-colors duration-500" />
          
          {/* Screenshot container */}
          <div class="relative bg-card/50 overflow-hidden rounded-lg">
            {/* Desktop Screenshot */}
            <div class="hidden md:block aspect-16/10 relative">
              {project.screenshot && (
                <img
                  src={project.screenshot}
                  alt={`${project.locales[locale].title} screenshot`}
                  class={`object-cover object-top transition-all duration-700 ${
                    imageLoaded ? "opacity-100 scale-100" : "opacity-0 scale-105"
                  } group-hover:scale-[1.03]`}
                  sizes="(max-width: 1024px) 100vw, 58vw"
                />
              )}
              {/* Directional overlay gradient based on text position */}
              <div class={`absolute inset-0 transition-opacity duration-500 ${
                isEven 
                  ? "bg-gradient-to-l from-background/90 via-background/50 to-transparent" 
                  : "bg-gradient-to-r from-background/90 via-background/50 to-transparent"
              }`} />
            </div>

            {/* Mobile Screenshot */}
            <div class="block md:hidden aspect-video relative">
              {project.screenshotMobile && (
                <img
                  src={project.screenshotMobile}
                  alt={`${project.locales[locale].title} mobile screenshot`}
                  class="object-cover object-center"
                  sizes="100vw"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/50 to-transparent" />
            </div>
          </div>

          {/* Hover indicator - positioned based on image side */}
          <div class={`absolute bottom-4 z-20 flex items-center gap-2 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300 ${
            isEven ? "left-4" : "right-4"
          }`}>
            <span class="text-xs font-mono text-foreground/80 bg-background/80 backdrop-blur-sm px-3 py-1.5 rounded-full border border-border/50">
              View Project
            </span>
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
              <Icon name="lucide:arrow-up-right" class="size-4 text-primary-foreground" />
            </div>
          </div>
        </a>
      </div>

      {/* Content Section */}
      <div
        class={`lg:col-span-6 ${
          isEven ? "lg:col-start-6 lg:text-left" : "lg:col-start-1 lg:text-right"
        } lg:row-start-1 relative z-10`}
      >
        <div class={`${isEven ? "lg:pl-8" : "lg:pr-8"}`}>
          {/* Label */}
          <span class="inline-block font-mono text-primary text-xs tracking-widest mb-3">
            FEATURED PROJECT
          </span>

          {/* Title */}
          <h3 class="text-2xl lg:text-3xl font-semibold text-foreground mb-4 group-hover:text-primary transition-colors duration-300">
            {project.locales[locale].title}
          </h3>

          {/* Description Card */}
          <div class={`bg-card/90 backdrop-blur-md p-6 rounded-lg border border-border/50 shadow-xl mb-6 ${
            isEven ? "" : "lg:ml-auto"
          }`}>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {project.locales[locale].description}
            </p>
          </div>

          {/* Technologies */}
          <div class={`flex flex-wrap gap-3 mb-6 ${isEven ? "" : "lg:justify-end"}`}>
            {project.technologies.map((tech) => (
              <TechIconMinimal name={tech} />
            ))}
          </div>

          {/* Links */}
          <div class={`flex items-center gap-5 ${isEven ? "" : "lg:justify-end"}`}>
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors group/link"
              aria-label={`GitHub repository for ${project.locales[locale].title}`}
            >
              <Icon name="lucide:github" class="size-5" />
              <span class="text-xs font-mono opacity-0 group-hover/link:opacity-100 transition-opacity">
                Code
              </span>
            </a>
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors group/link"
              aria-label={`Live demo for ${project.locales[locale].title}`}
            >
              <Icon name="lucide:external-link" class="size-5" />
              <span class="text-xs font-mono opacity-0 group-hover/link:opacity-100 transition-opacity">
                Live
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</AnimatedSection>
