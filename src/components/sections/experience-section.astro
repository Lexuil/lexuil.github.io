---
import AnimatedSection from "@/components/animated-section.astro";
import TechIcon from "@/components/tech-icon.astro";
import { Icon } from "astro-icon/components";
import type { Experience } from '@/types/experience'
import type { Locales } from "@/types/locales";

const locale = Astro.currentLocale as Locales;

interface Props {
  experiences: Experience[];
}
const { experiences } = Astro.props;
---

<section id="experience" class="py-24 lg:py-32 px-6 lg:px-12">
  <div class="max-w-6xl mx-auto">
    <AnimatedSection>
      <div class="flex items-center gap-4 mb-20">
        <span class="font-mono text-primary/60 text-sm">01.</span>
        <h2 class="text-sm tracking-[0.2em] uppercase text-muted-foreground">
          Experience
        </h2>
        <div class="flex-1 h-px bg-border/50" />
      </div>
    </AnimatedSection>

    <div class="space-y-2">
      {experiences.map((exp, index) => (
        <AnimatedSection delay={index * 100}>
          <a
            href={exp.companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group block p-6 -mx-6 rounded-xl hover:bg-card/50 transition-all duration-300"
          >
            <div class="grid lg:grid-cols-[180px_1fr] gap-4 lg:gap-12">
              <div class="text-xs tracking-wider text-muted-foreground/60 font-mono pt-1">
                {exp.period}
              </div>
              <div>
                <h3 class="text-base font-medium text-foreground mb-1 flex items-center gap-2 group-hover:text-primary transition-colors">
                  {exp.locales[locale].role}
                  <span class="text-muted-foreground">·</span>
                  <span class="text-primary/80">{exp.company}</span>
                  <Icon name="lucide:arrow-up-right" class="size-4 opacity-0 -translate-y-1 translate-x-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:translate-x-0 transition-all duration-300" />
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed mb-5 max-w-xl">
                  {exp.locales[locale].description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {exp.technologies.map((tech) => (
                    <TechIcon name={tech} size="sm" />
                  ))}
                </div>
              </div>
            </div>
          </a>
        </AnimatedSection>
      ))}
    </div>
  </div>
</section>