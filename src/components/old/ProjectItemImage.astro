---
import { Image } from "astro:assets";
import type { Locales } from "src/types/locales";
import { pageData } from "@assets/data/pageData";

interface Props {
  name: string;
  link: string | undefined;
  imageUrl: string;
  smallImageUrl: string;
}
const { name, link, imageUrl, smallImageUrl } = Astro.props;
const locale = Astro.currentLocale as Locales;
---

<div class="flex flex-col items-center my-10 sm:my-5">
  <a
    class:list={[
      {
        "pointer-events-none": link === undefined,
      },
    ]}
    href={link ?? "#"}
    aria-disabled={link === undefined}
    target="_blank"
  >
    <!-- Desktop image -->
    <Image
      src={imageUrl}
      class="hidden sm:block w-full h-auto rounded-xl aspect-video hover:border-2 hover:border-red-500 hover:scale-105 transition-all object-cover"
      width={620}
      height={350}
      alt={`${pageData[locale].alt.projectScreenshot} ${name}`}
    />

    <!-- Mobile image -->
    <Image
      src={smallImageUrl}
      class="block sm:hidden w-full h-auto rounded-xl aspect-[9/16] object-cover"
      width={488}
      height={868}
      alt={`${pageData[locale].alt.projectScreenshot} ${name}`}
    />
  </a>
</div>
