---
import { cn } from '@/lib/utils'
import { techIcons } from '@/types/tech-icons'
import { Icon } from 'astro-icon/components'

interface Props {
  name: string
  showLabel?: boolean
  size?: 'sm' | 'md' | 'lg'
}

const { name, showLabel = false, size = 'md' } = Astro.props

const tech = techIcons[name]
const iconSize = { sm: 'size-4', md: 'size-5', lg: 'size-7' }[size]
const tooltipClass =
  'pointer-events-none absolute left-1/2 top-0 z-20 -translate-x-1/2 -translate-y-[calc(100%+0.4rem)] whitespace-nowrap rounded-md border border-border/80 bg-popover px-2 py-1 text-[10px] font-medium tracking-wide text-popover-foreground opacity-0 shadow-lg shadow-black/20 transition-all duration-200 ease-out group-hover/tech:opacity-100 group-hover/tech:-translate-y-[calc(100%+0.55rem)]'
const tooltipArrowClass =
  'absolute left-1/2 top-full size-1.5 -translate-x-1/2 -translate-y-1/2 rotate-45 border-r border-b border-border/80 bg-popover'
---

{
  !tech ? (
    <span class="group/tech relative inline-flex cursor-default px-2.5 py-1 text-[10px] tracking-wider rounded-md bg-card text-muted-foreground border border-border/50 font-mono">
      {name}
      {!showLabel && (
        <span role="tooltip" class={tooltipClass}>
          {name}
          <span class={tooltipArrowClass} />
        </span>
      )}
    </span>
  ) : (
    <span class="group/tech relative inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] tracking-wide rounded-md bg-card/80 border border-border/50 transition-all duration-300 hover:border-border hover:bg-card cursor-default">
      <Icon
        name={tech.icon}
        class={cn(
          'opacity-70 group-hover/tech:opacity-100 transition-opacity duration-300',
          iconSize
        )}
        style={{ color: tech.color }}
      />
      {showLabel && (
        <span class="text-muted-foreground group-hover/tech:text-foreground transition-colors duration-300 font-medium">
          {name}
        </span>
      )}
      {!showLabel && (
        <span role="tooltip" class={tooltipClass}>
          {name}
          <span class={tooltipArrowClass} />
        </span>
      )}
    </span>
  )
}
