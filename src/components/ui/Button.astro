---
type Props = {
  href?: string
  target?: string
}

const { href, target } = Astro.props

const buttonClass =
  'bg-transparent hover:bg-red-500 text-neutral-200 hover:text-black py-2 px-4 border border-neutral-100 hover:border-transparent rounded'
---

{
  href === undefined ? (
    <button class={buttonClass} disabled>
      <slot />
    </button>
  ) : (
    <a href={href} class={buttonClass} target={target}>
      <slot />
    </a>
  )
}
