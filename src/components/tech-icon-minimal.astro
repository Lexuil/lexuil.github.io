---
import { techIcons } from '@/types/tech-icons';
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
}

const { name } = Astro.props;

const tech = techIcons[name];
---

{!tech
  ? <span class="text-[11px] text-muted-foreground/70 font-mono">{name}</span>
  : <span class="inline-flex items-center gap-1.5 text-[11px] group cursor-default">
      <Icon
        name={tech.icon}
        class="opacity-70 group-hover:opacity-100 transition-opacity duration-300 size-4"
        style={{ color: tech.color }}
      />
      <span class="text-muted-foreground/70 group-hover:text-muted-foreground transition-colors duration-300 font-mono">
        {name}
      </span>
    </span>
}