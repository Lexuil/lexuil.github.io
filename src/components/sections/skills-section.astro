---
import AnimatedSection from "@/components/animated-section.astro";
import TechIcon from "@/components/tech-icon.astro";
import SectionContainer from "@/components/section-container.astro";
import SectionHeading from "@/components/section-heading.astro";

interface Props {
  skillCategories: {
    name: string;
    skills: string[];
  }[];
}

const { skillCategories } = Astro.props;
---

<SectionContainer id="skills" class="py-24 lg:py-32">
  <SectionHeading number="04." title="Technologies" />

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
    {skillCategories.map((category, categoryIndex) => (
      <AnimatedSection delay={categoryIndex * 100}>
        <div>
          <h3 class="text-xs font-mono text-primary/70 tracking-wider mb-6 pb-3 border-b border-border/30">
            {category.name}
          </h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <div>
                <TechIcon name={skill} size="md" showLabel />
              </div>
            ))}
          </div>
        </div>
      </AnimatedSection>
    ))}
  </div>
</SectionContainer>
