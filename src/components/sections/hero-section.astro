---
import { AnimatedSection } from '@/components/animated-section';
import { Planets } from '@/components/planets';
import { Icon } from "astro-icon/components";
import type { Profile } from '@/types/profile'
import type { Locales } from "@/types/locales";

const locale = Astro.currentLocale as Locales;

interface Props {
  profile: Profile
}
const { profile } = Astro.props;
---

<section
  id="about"
  class="relative min-h-screen flex flex-col justify-center px-6 lg:px-12 pt-20 overflow-hidden"
>
  <Planets client:load />

  {/* Main content grid */}
  <div class="relative z-10 max-w-6xl w-full mx-auto grid lg:grid-cols-[1fr_1.2fr] gap-16 lg:gap-24 items-center">
    {/* Left column - Name & Title */}
    <div class="lg:sticky lg:top-32">
      <AnimatedSection client:load>
        <span class="inline-block text-primary/80 text-xs tracking-[0.3em] uppercase mb-6 font-mono">
          Hi, I am
        </span>
      </AnimatedSection>

      <AnimatedSection delay={100} client:load>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground mb-3 tracking-tight text-balance leading-[1.1]">
          {profile.name}
        </h1>
      </AnimatedSection>

      <AnimatedSection delay={200} client:load>
        <h2 class="text-lg sm:text-xl text-primary font-medium mb-8 tracking-tight">
          {profile.locales[locale].title}
        </h2>
      </AnimatedSection>

      <AnimatedSection delay={300} client:load>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-sm">
          {profile.locales[locale].tagline}
        </p>
      </AnimatedSection>

      <AnimatedSection delay={400} client:load>
        <nav class="mt-12 hidden lg:block">
          <ul class="flex flex-col gap-4">
            {['About', 'Experience', 'Projects', 'Skills'].map((item) => (
              <li>
                <a
                  href={`#${item.toLowerCase()}`}
                  class="group flex items-center gap-3 text-xs tracking-[0.2em] uppercase text-muted-foreground hover:text-foreground transition-colors"
                >
                  <span class="w-8 h-px bg-muted-foreground/30 group-hover:w-12 group-hover:bg-foreground transition-all duration-300" />
                  {item}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </AnimatedSection>

      <AnimatedSection delay={500} client:load>
        <div class="flex items-center gap-5 mt-12">
          <a
            href={profile.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-foreground transition-colors p-2 -m-2"
            aria-label="GitHub"
          >
            <Icon name="lucide:github" class="size-4.5" />
          </a>
          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-foreground transition-colors p-2 -m-2"
            aria-label="LinkedIn"
          >
            <Icon name="lucide:linkedin" class="size-4.5" />
          </a>
          <a
            href={`mailto:${profile.email}`}
            class="text-muted-foreground hover:text-foreground transition-colors p-2 -m-2"
            aria-label="Email"
          >
            <Icon name="lucide:mail" class="size-4.5" />
          </a>
        </div>
      </AnimatedSection>
    </div>

    {/* Right column - Bio */}
    <div class="lg:py-24">
      <AnimatedSection delay={300} client:load>
        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed mb-6">
          {profile.locales[locale].bio}
        </p>
      </AnimatedSection>
      <AnimatedSection delay={400} client:load>
        <p class="text-sm sm:text-base text-muted-foreground/80 leading-relaxed">
          {profile.locales[locale].extendedBio}
        </p>
      </AnimatedSection>
    </div>
  </div>

  {/* Scroll indicator */}
  <AnimatedSection delay={800} client:load>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-muted-foreground/50">
      <Icon name="lucide:arrow-down" class="size-4 animate-bounce" />
    </div>
  </AnimatedSection>
</section>
