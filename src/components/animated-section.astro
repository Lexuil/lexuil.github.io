---
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  className?: string
  delay?: number
}

const { class: classProp, className, delay = 0 } = Astro.props
---

<div
  class={cn('will-change-transform opacity-0 translate-y-8', classProp, className)}
  data-animated-element
  data-delay={String(delay)}
>
  <slot />
</div>

<script>
  import { animate } from 'motion/mini'
  import { inView } from 'motion'

  inView('[data-animated-element]', (element) => {
    const delay = Number(element.getAttribute('data-delay') ?? '0') / 1000
    animate(
      element,
      { opacity: 1, transform: 'translateY(0px)' },
      { duration: 0.7, ease: 'easeOut', delay }
    )
  })
</script>
