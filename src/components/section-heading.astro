---
import AnimatedSection from '@/components/animated-section.astro'

interface Props {
  number: string
  title: string
  class?: string
}

const { number, title, class: className = 'mb-20' } = Astro.props
---

<AnimatedSection>
  <div class={`flex items-center gap-4 ${className}`.trim()}>
    <span class="font-mono text-primary/60 text-sm">{number}</span>
    <h2 class="text-sm tracking-[0.2em] uppercase text-muted-foreground">
      {title}
    </h2>
    <div class="flex-1 h-px bg-border/50"></div>
  </div>
</AnimatedSection>
