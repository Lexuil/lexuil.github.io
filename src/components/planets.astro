<div class="fixed inset-0 overflow-hidden pointer-events-none">
  {/* Large ringed planet - top right */}
  <div
    class="absolute top-[30%] left-[75%] -translate-x-1/2 -translate-y-1/2 opacity-0"
    data-delay="200"
    data-planet="1"
  >
    <svg viewBox="0 0 120 120" class="size-50 md:size-70 lg:size-100 animate-float">
      {/* Planet body */}
      <circle
        cx="60"
        cy="60"
        r="35"
        fill="rgba(140, 180, 200, 0.04)"
        stroke="rgba(140, 180, 200, 0.15)"
        vector-effect="non-scaling-stroke"
        stroke-width="1"></circle>
      {/* Inner circle detail */}
      <circle
        cx="60"
        cy="60"
        r="25"
        fill="none"
        stroke="rgba(140, 180, 200, 0.08)"
        vector-effect="non-scaling-stroke"
        stroke-width="0.5"></circle>
      {/* Ring - back */}
      <ellipse
        cx="60"
        cy="60"
        rx="55"
        ry="14"
        fill="none"
        stroke="rgba(140, 180, 200, 0.12)"
        vector-effect="non-scaling-stroke"
        stroke-width="1"
        stroke-dasharray="2 3"
        transform="rotate(-15 60 60)"></ellipse>
      {/* Ring - front */}
      <ellipse
        cx="60"
        cy="60"
        rx="48"
        ry="11"
        fill="none"
        stroke="rgba(140, 180, 200, 0.08)"
        vector-effect="non-scaling-stroke"
        stroke-width="0.5"
        transform="rotate(-15 60 60)"></ellipse>
    </svg>
  </div>

  {/* Medium planet - bottom left */}
  <div
    class="absolute top-[60%] left-[30%] -translate-x-1/2 -translate-y-1/2 opacity-0"
    data-delay="400"
    data-planet="2"
  >
    <svg viewBox="0 0 80 80" class="size-20 md:size-30 lg:size-50 animate-float-slow">
      {/* Planet body */}
      <circle
        cx="40"
        cy="40"
        r="28"
        fill="rgba(160, 140, 180, 0.03)"
        stroke="rgba(160, 140, 180, 0.12)"
        vector-effect="non-scaling-stroke"
        stroke-width="1"></circle>
      {/* Surface line details */}
      <path
        d="M 20 35 Q 40 32 60 38"
        fill="none"
        stroke="rgba(160, 140, 180, 0.08)"
        vector-effect="non-scaling-stroke"
        stroke-width="0.5"></path>
      <path
        d="M 22 45 Q 40 48 58 43"
        fill="none"
        stroke="rgba(160, 140, 180, 0.06)"
        vector-effect="non-scaling-stroke"
        stroke-width="0.5"></path>
    </svg>
  </div>

  {/* Small moon - middle right */}
  <div
    class="absolute top-[30%] left-[75%] -translate-x-1/2 -translate-y-1/2 opacity-0 size-150 flex justify-end items-end"
    data-delay="600"
    data-planet="3"
  >
    <div class="w-fit">
      <svg viewBox="0 0 40 40" class="size-15 md:size-25 lg:size-35 animate-float-reverse">
        {/* Moon body */}
        <circle
          cx="20"
          cy="20"
          r="12"
          fill="rgba(200, 200, 210, 0.03)"
          stroke="rgba(200, 200, 210, 0.15)"
          vector-effect="non-scaling-stroke"
          stroke-width="1"></circle>
        {/* Craters */}
        <circle
          cx="16"
          cy="18"
          r="3"
          fill="none"
          stroke="rgba(200, 200, 210, 0.1)"
          stroke-width="0.5"
          vector-effect="non-scaling-stroke"></circle>
        <circle
          cx="24"
          cy="22"
          r="2"
          fill="none"
          stroke="rgba(200, 200, 210, 0.08)"
          vector-effect="non-scaling-stroke"
          stroke-width="0.5"></circle>
      </svg>
    </div>
  </div>

  {/* Tiny moon - top left */}
  <div
    class="absolute top-[60%] left-[30%] -translate-x-1/2 -translate-y-1/2 opacity-0 size-160"
    data-delay="800"
    data-planet="4"
  >
    <div class="w-fit">
      <svg
        viewBox="0 0 24 24"
        class="size-10 md:size-20 lg:size-25 animate-float"
        style={{ animationDelay: '1s' }}
      >
        <circle
          cx="12"
          cy="12"
          r="8"
          fill="rgba(180, 200, 220, 0.03)"
          stroke="rgba(180, 200, 220, 0.12)"
          stroke-width="0.5"
          vector-effect="non-scaling-stroke"></circle>
      </svg>
    </div>
  </div>

  {/* Extra small distant planet - bottom right */}
  <div
    class="absolute bottom-[35%] right-[45%] opacity-0 scale-50"
    data-delay="1000"
    data-planet="5"
  >
    <svg
      viewBox="0 0 20 20"
      class="size-10 md:size-14 animate-float-slow"
      style={{ animationDelay: '0.5s' }}
    >
      <circle
        cx="10"
        cy="10"
        r="6"
        fill="rgba(170, 180, 200, 0.02)"
        stroke="rgba(170, 180, 200, 0.1)"
        stroke-width="0.5"
        vector-effect="non-scaling-stroke"></circle>
    </svg>
  </div>
</div>

<script>
  import { animate, inView, scroll } from 'motion'

  inView('[data-planet]', (element) => {
    const delay = Number(element.getAttribute('data-delay') ?? '0') / 1000
    animate(element, { opacity: 1, scale: 1 }, { duration: 0.8, ease: 'easeOut', delay })
  })

  // Moon orbit
  animate(
    '[data-planet="3"]',
    { rotate: [0, 360] },
    {
      duration: 40,
      repeat: Infinity,
      ease: 'linear'
    }
  )

  // Keep moon facing the same direction
  animate(
    '[data-planet="3"] > div',
    { rotate: [0, -360] },
    { duration: 40, repeat: Infinity, ease: 'linear' }
  )

  // Tiny moon orbiting
  animate(
    '[data-planet="4"]',
    { rotate: [0, 360] },
    {
      duration: 70,
      repeat: Infinity,
      ease: 'linear'
    }
  )

  scroll(
    animate('[data-planet="1"]', { y: ['0vh', '40vh'], x: ['0vw', '5vw'] }, { ease: 'linear' })
  )
  scroll(
    animate('[data-planet="3"]', { y: ['0vh', '40vh'], x: ['0vw', '5vw'] }, { ease: 'linear' })
  )
  scroll(
    animate('[data-planet="2"]', { y: ['0vh', '-40vh'], x: ['0vw', '5vw'] }, { ease: 'linear' })
  )
  scroll(
    animate('[data-planet="4"]', { y: ['0vh', '-40vh'], x: ['0vw', '5vw'] }, { ease: 'linear' })
  )
</script>
